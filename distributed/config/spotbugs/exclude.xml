<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for the distributed runtime. Each exclusion must state why it is safe.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2: immutable records copy their collections in their constructors; components
    that hold collaborators (connections, registries, configuration objects) share them deliberately. The same
    exclusion and rule apply in DistriCompute-Core.
  -->
  <Match>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>
</FindBugsFilter>
