# Copy to .env (never committed) and change the values. docs/deployment.md describes every setting.

# Password of the MySQL user "districompute" (required).
DISTRICOMPUTE_DB_PASSWORD=change-this-database-password

# Password of the first administrator "admin" (optional, at least 12 characters). Without it the application
# generates one into /data/initial-admin-password: docker compose exec app cat /data/initial-admin-password
DISTRICOMPUTE_ADMIN_PASSWORD=

# Address the interface is published on (127.0.0.1: this machine only; 0.0.0.0: every interface).
DISTRICOMPUTE_HTTP_BIND=127.0.0.1
